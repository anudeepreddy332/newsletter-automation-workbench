# Optional WordPress.com test-site ID. Server-side only.
# Do not put real values in this file.
# WORDPRESS_SITE_ID=

# Optional local Postgres URL for the integration-hardening drill.
# Server-side only. Never use NEXT_PUBLIC_* for this value.
# The existing newsletter workbench does not require this variable.
# INTEGRATION_DATABASE_URL=postgres://integration:integration@127.0.0.1:5433/newsletter_integration

# Optional FastAPI base URL for drill mode. Server-side only.
# Never use NEXT_PUBLIC_* for this value. Default demo mode does not need it.
# INTEGRATION_API_BASE_URL=http://127.0.0.1:8000

# Runtime mode. Default is demo (existing fixture source, no FastAPI/Postgres).
# NEWSLETTER_INTEGRATION_MODE=demo
# NEWSLETTER_INTEGRATION_MODE=drill

# Do not store the OAuth access token in a Next.js .env / .env.local file.
# Shell and env-file loading can transform token characters.
# Save the raw token (no quotes, one line) in the gitignored file:
#   .wordpress-demo-token
# Then export it for the demo process as documented in docs/DEMO_RUN.md.
